<script>
document.addEventListener('DOMContentLoaded', function () {
  const rouletteItems = {{ rouletteItems|default([])|json_encode|raw }};
  const rouletteWheel = document.getElementById('homeRouletteWheel');
  const rouletteSpin = document.getElementById('homeRouletteSpin');
  const resultCard = document.getElementById('homeRouletteResult');
  const resultImage = document.getElementById('homeRouletteResultImage');
  const resultTitle = document.getElementById('homeRouletteResultTitle');
  const resultPrice = document.getElementById('homeRouletteResultPrice');

  if (!rouletteWheel || !rouletteItems.length) {
    return;
  }

  const wheelItems = rouletteItems;
  const slice = 360 / wheelItems.length;
  rouletteWheel.innerHTML = '';

  const svgNs = 'http://www.w3.org/2000/svg';
  const xlinkNs = 'http://www.w3.org/1999/xlink';
  const svg = document.createElementNS(svgNs, 'svg');
  svg.setAttribute('viewBox', '0 0 100 100');
  svg.setAttribute('aria-hidden', 'true');

  const defs = document.createElementNS(svgNs, 'defs');
  svg.appendChild(defs);

  const polarPoint = (angleDeg, radius = 50) => {
    const angleRad = (angleDeg - 90) * Math.PI / 180;
    return {
      x: 50 + radius * Math.cos(angleRad),
      y: 50 + radius * Math.sin(angleRad)
    };
  };

  const slicePath = (startAngle, endAngle) => {
    const start = polarPoint(startAngle);
    const end = polarPoint(endAngle);
    const largeArc = endAngle - startAngle > 180 ? 1 : 0;
    return `M 50 50 L ${start.x.toFixed(3)} ${start.y.toFixed(3)} A 50 50 0 ${largeArc} 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)} Z`;
  };

  wheelItems.forEach((item, index) => {
    const startAngle = index * slice;
    const endAngle = startAngle + slice;
    const middleAngle = startAngle + (slice / 2);
    const pathData = slicePath(startAngle, endAngle);
    const clipId = `roulette-slice-${index}`;

    const clipPath = document.createElementNS(svgNs, 'clipPath');
    clipPath.setAttribute('id', clipId);

    const clipShape = document.createElementNS(svgNs, 'path');
    clipShape.setAttribute('d', pathData);
    clipPath.appendChild(clipShape);
    defs.appendChild(clipPath);

    const image = document.createElementNS(svgNs, 'image');
    image.setAttribute('x', '0');
    image.setAttribute('y', '0');
    image.setAttribute('width', '100');
    image.setAttribute('height', '100');
    image.setAttribute('preserveAspectRatio', 'xMidYMid slice');
    image.setAttribute('clip-path', `url(#${clipId})`);
    image.setAttribute('class', 'roulette-slice-image');
    image.setAttributeNS(xlinkNs, 'href', item.image || '{{ asset('assets/img/favicon.png') }}');
    image.setAttribute('href', item.image || '{{ asset('assets/img/favicon.png') }}');
    svg.appendChild(image);

    const shade = document.createElementNS(svgNs, 'path');
    shade.setAttribute('d', pathData);
    shade.setAttribute('class', 'roulette-slice-shade');
    svg.appendChild(shade);

    const border = document.createElementNS(svgNs, 'path');
    border.setAttribute('d', pathData);
    border.setAttribute('class', 'roulette-slice-border');
    svg.appendChild(border);

    const titlePoint = polarPoint(middleAngle, 34);
    const title = document.createElementNS(svgNs, 'text');
    title.setAttribute('x', titlePoint.x.toFixed(2));
    title.setAttribute('y', titlePoint.y.toFixed(2));
    title.setAttribute('class', 'roulette-slice-title');
    title.textContent = item.titre || item.name || 'Plat';
    svg.appendChild(title);
  });

  rouletteWheel.appendChild(svg);

  let currentRotation = 0;
  let isSpinning = false;

  const updateWinner = (item) => {
    if (!item || !resultCard) {
      return;
    }

    const title = item.titre || item.name || 'Plat surprise';
    const price = item.price ? `${item.price} DT` : 'Disponible dans le menu';

    if (resultImage) {
      resultImage.src = item.image || '{{ asset('assets/img/favicon.png') }}';
      resultImage.alt = title;
    }

    if (resultTitle) {
      resultTitle.textContent = title;
    }

    if (resultPrice) {
      resultPrice.textContent = price;
    }

    resultCard.classList.add('is-visible');
  };

  updateWinner(wheelItems[0]);

  if (rouletteSpin) {
    rouletteSpin.addEventListener('click', async function () {
      if (isSpinning) {
        return;
      }

      isSpinning = true;
      rouletteSpin.disabled = true;
      const originalButtonHtml = rouletteSpin.innerHTML;

      let payload;
      try {
        const response = await fetch('{{ path('user_rewards_spin') }}', {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({})
        });

        payload = await response.json();
        if (!response.ok || !payload.success) {
          if (payload.redirectUrl) {
            window.location.href = payload.redirectUrl;
            return;
          }
          throw new Error(payload.message || 'Roulette non disponible.');
        }
      } catch (error) {
        if (resultTitle) {
          resultTitle.textContent = 'Roulette bloquee';
        }
        if (resultPrice) {
          resultPrice.textContent = error.message || 'Vous devez depasser le seuil de commandes validees.';
        }
        if (resultCard) {
          resultCard.classList.add('is-visible');
        }
        rouletteSpin.disabled = false;
        rouletteSpin.innerHTML = originalButtonHtml;
        isSpinning = false;
        return;
      }

      const result = payload.result;
      const pool = rouletteItems;
      const winnerIndex = Math.max(pool.findIndex((item) => {
        const itemId = String(item.id ?? item.key ?? '');
        const resultId = String(result.id ?? result.key ?? '');
        return itemId !== '' && itemId === resultId;
      }), 0);
      const winnerMiddleAngle = (winnerIndex * slice) + (slice / 2);
      const currentAngle = ((currentRotation % 360) + 360) % 360;
      const targetAngle = (360 - winnerMiddleAngle) % 360;
      const alignmentDelta = (targetAngle - currentAngle + 360) % 360;
      const targetRotation = (360 * 5) + alignmentDelta;

      currentRotation += targetRotation;
      rouletteWheel.style.transform = `rotate(${currentRotation}deg)`;

      window.setTimeout(function () {
        updateWinner(result);
        rouletteSpin.innerHTML = '<i class="bi bi-check2-circle"></i><span>Roulette utilisee</span>';
        isSpinning = false;

        window.setTimeout(function () {
          window.location.href = payload.redirectUrl || '{{ path('app_menu_commande') }}?rouletteGift=1';
        }, 1800);
      }, 4100);
    });
  }
});
</script>

