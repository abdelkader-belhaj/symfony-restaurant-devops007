<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon profil - Délicieux</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Poppins:wght@300;400;500;600;700&family=Satisfy&display=swap" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <style>
        :root {
            --bg: #0c0b09;
            --card: rgba(26, 24, 20, 0.95);
            --card-border: rgba(205, 164, 94, 0.2);
            --text: #ffffff;
            --text-muted: #a49b89;
            --primary: #cda45e;
            --primary-hover: #d9ba85;
            --success: #28a745;
            --shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            --font-primary: 'Poppins', sans-serif;
            --font-secondary: 'Playfair Display', serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: var(--font-primary);
            color: var(--text);
            background: var(--bg);
            min-height: 100vh;
        }

        .page-shell {
            position: relative;
            min-height: 100vh;
            background: url('{{ asset("assets/img/hero-carousel/hero-carousel-1.jpg") }}') center center no-repeat;
            background-size: cover;
            background-attachment: fixed;
        }

        .page-shell::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1;
        }

        .content-wrapper {
            position: relative;
            z-index: 2;
            padding-bottom: 50px;
        }

        .profile-hero {
            padding: 80px 0 40px;
            text-align: center;
        }

        .brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 20px;
            border-radius: 50px;
            background: rgba(205, 164, 94, 0.1);
            border: 1px solid var(--primary);
            color: var(--primary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.8rem;
            margin-bottom: 20px;
        }

        .hero-title span {
            color: var(--primary);
            font-family: 'Satisfy', cursive;
        }

        .hero-title {
            font-family: var(--font-secondary);
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            margin-bottom: 15px;
            color: #fff;
        }

        .hero-text {
            max-width: 600px;
            margin: 0 auto 30px;
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .btn-gold {
            background: none;
            color: #fff;
            border: 2px solid var(--primary);
            padding: 12px 35px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.4s;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .btn-gold:hover {
            background: var(--primary);
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(205, 164, 94, 0.3);
        }

        .btn-outline-gold {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.2);
            padding: 12px 35px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.4s;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .btn-outline-gold:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .glass-card {
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 15px;
            padding: 30px;
            box-shadow: var(--shadow);
            transition: 0.3s;
        }

        .glass-card:hover {
            border-color: var(--primary);
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-family: var(--font-secondary);
            color: var(--primary);
            background: rgba(205, 164, 94, 0.05);
            margin: 0 auto 20px;
        }

        .profile-name {
            font-family: var(--font-secondary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 5px;
            text-align: center;
        }

        .profile-role {
            color: var(--primary);
            font-weight: 500;
            text-align: center;
            display: block;
            margin-bottom: 25px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .metric-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }

        .metric-value {
            display: block;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            font-family: var(--font-secondary);
        }

        .metric-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title {
            font-family: var(--font-secondary);
            font-size: 1.5rem;
            color: #fff;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--primary);
            display: inline-block;
        }

        .info-row {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(205, 164, 94, 0.1);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .info-label {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .info-value {
            font-weight: 500;
        }

        .form-label {
            color: var(--text-muted);
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0;
            color: #fff;
            padding: 12px 15px;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--primary);
            box-shadow: none;
            color: #fff;
        }

        .reservation-item {
            background: rgba(255, 255, 255, 0.02);
            border-left: 3px solid var(--primary);
            padding: 20px;
            margin-bottom: 15px;
            transition: 0.3s;
        }

        .reservation-item:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        .status-badge {
            font-size: 0.7rem;
            padding: 5px 12px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-pending { background: rgba(205, 164, 94, 0.2); color: var(--primary); border: 1px solid var(--primary); }
        .status-reserved { background: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid #28a745; }

        .hover-gold:hover {
            color: var(--primary) !important;
            transition: 0.3s;
        }

        .reservation-scroll {
            max-height: 320px;
            overflow-y: auto;
            padding-right: 5px;
        }
        .reservation-scroll::-webkit-scrollbar {
            width: 5px;
        }
        .reservation-scroll::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
        }
        .reservation-scroll::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }
        .reservation-scroll::-webkit-scrollbar-thumb:hover {
            background: #b8944e;
        }

        .fade-in-up {
            animation: fadeInUp 0.8s ease-out both;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 768px) {
            .hero-title { font-size: 2.5rem; }
            .metric-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <!-- Header -->
        <nav class="navbar navbar-expand-lg py-3" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(10px); position: relative; z-index: 10; border-bottom: 1px solid var(--card-border);">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="{{ path('front_index') }}">
                    <span style="font-family: 'Satisfy', cursive; color: var(--primary); font-size: 1.8rem;">Délicieux</span>
                </a>
                <div class="ms-auto d-flex align-items-center gap-3">
                    {% if app.session.get('user') %}
                        {% set unclaimed_rewards = has_unclaimed_rewards(app.session.get('user')) %}
                        <div class="dropdown">
                            <button class="btn btn-outline-gold btn-sm dropdown-toggle d-flex align-items-center" type="button" id="profileMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i>
                                <span>{{ app.session.get('user').nomComplete|default('Compte') }}</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="profileMenuDropdown">
                                <li class="dropdown-header pb-3 pt-2">
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar-initials me-3" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #f5c96b); color: #111; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                            {{ app.session.get('user').nomComplete|slice(0, 1)|upper }}
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 1rem;">{{ app.session.get('user').nomComplete }}</h6>
                                            <small class="text-muted" style="font-size: 0.8rem;">{{ app.session.get('user').email }}</small>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider my-0 opacity-10"></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center" href="{{ path('user_profile') }}">
                                        <div class="icon-box me-3 bg-light-blue" style="width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        <span>Mon Profil</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center position-relative" href="{{ path('user_rewards') }}">
                                        <div class="icon-box me-3 bg-light-gold" style="width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-gift text-warning"></i>
                                        </div>
                                        <span>Mes Cadeaux</span>
                                        {% if unclaimed_rewards %}
                                            <span class="badge rounded-pill bg-danger ms-auto">Nouveau</span>
                                        {% endif %}
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1 opacity-10"></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center text-danger" href="{{ path('app_logout') }}">
                                        <div class="icon-box me-3 bg-light-danger" style="width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </div>
                                        <span>Déconnexion</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>

        <div class="content-wrapper">
            <div class="container profile-hero">
                <div class="fade-in-up">
                    <span class="brand-pill"><i class="bi bi-stars"></i> Espace Privilège</span>
                    <h1 class="hero-title">Bienvenue, <span>{{ user.nomComplete|default('Cher Client') }}</span></h1>
                    <p class="hero-text">
                        Gérez vos préférences gastronomiques et suivez vos réservations dans votre espace dédié Délicieux.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="#profile-form" class="btn-gold text-decoration-none">
                            <i class="bi bi-pencil-square me-2"></i> Éditer le profil
                        </a>
                        <a href="{{ path('front_index') }}" class="btn-outline-gold text-decoration-none">
                            <i class="bi bi-house-door me-2"></i> Site Principal
                        </a>
                    </div>
                </div>
            </div>

            <div class="container">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} bg-dark text-white border-{{ label == 'danger' ? 'danger' : 'warning' }} fade-in-up mb-4" role="alert">
                            <i class="bi bi-{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }} me-2 text-warning"></i>
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="glass-card fade-in-up" style="animation-delay: 0.1s;">
                            <div class="profile-avatar" id="profileAvatar">
                                {{ user.nomComplete|default('C')|slice(0, 1)|upper }}
                            </div>
                            <h2 class="profile-name">{{ user.nomComplete|default('Client') }}</h2>
                            <span class="profile-role">Membre Délicieux</span>

                            <div class="metric-grid">
                                <div class="metric-box">
                                    <span class="metric-label">Réservations</span>
                                    <span class="metric-value">{{ user.reservationsCount|default(0) }}</span>
                                </div>
                                <div class="metric-box">
                                    <span class="metric-label">Points</span>
                                    <span class="metric-value">{{ user.points|default(0) }}</span>
                                </div>
                            </div>

                            <div class="mt-4 pt-2">
                                <h3 class="section-title" style="font-size: 1.1rem;">Coordonnées</h3>
                                <div class="info-row">
                                    <div class="info-icon"><i class="bi bi-envelope"></i></div>
                                    <div>
                                        <div class="info-label">Email Professionnel</div>
                                        <div class="info-value text-break">{{ user.email|default('Non renseigné') }}</div>
                                    </div>
                                </div>
                                <div class="info-row">
                                    <div class="info-icon"><i class="bi bi-telephone"></i></div>
                                    <div>
                                        <div class="info-label">Téléphone</div>
                                        <div class="info-value">{{ user.tel|default('Non renseigné') }}</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <a href="{{ path('app_logout') }}" class="btn-outline-gold w-100 text-center text-decoration-none py-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="glass-card fade-in-up mb-4" id="profile-form" style="animation-delay: 0.2s;">
                            <h3 class="section-title">Informations Personnelles</h3>
                            <p class="text-muted small mb-4">Maintenez vos données à jour pour faciliter vos prochaines réservations.</p>

                            <form method="post" class="row g-4" id="profileUpdateForm">
                                <div class="col-md-6">
                                    <label class="form-label" for="nomComplete">Nom Complet</label>
                                    <input type="text" id="nomComplete" name="nomComplete" class="form-control" value="{{ user.nomComplete|default('') }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="email">Adresse Email</label>
                                    <input type="email" id="email" name="email" class="form-control" value="{{ user.email|default('') }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="tel">Téléphone (optionnel)</label>
                                    <input type="text" id="tel" name="tel" class="form-control" value="{{ user.tel|default('') }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="pwd">
                                        {% if user.provider|default('') == 'google' and not user.hasPassword|default(false) %}
                                            Définir un mot de passe
                                        {% else %}
                                            Nouveau mot de passe (optionnel)
                                        {% endif %}
                                    </label>
                                    {% if user.provider|default('') == 'google' %}
                                        <p class="text-muted small mb-2">
                                            {% if user.hasPassword|default(false) %}
                                                Vous pouvez vous connecter avec Google ou avec email et mot de passe.
                                            {% else %}
                                                Ajoutez un mot de passe pour vous connecter aussi avec email et mot de passe, en plus de Google.
                                            {% endif %}
                                        </p>
                                    {% endif %}
                                    <div class="input-group">
                                        <input type="password" id="pwd" name="pwd" class="form-control" placeholder="Laisser vide pour conserver">
                                        <button class="btn btn-outline-secondary border-secondary-subtle" type="button" id="togglePassword" style="border-radius: 0;">
                                            <i class="bi bi-eye text-white"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn-gold">
                                        <i class="bi bi-save me-2"></i> Enregistrer les changements
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="glass-card fade-in-up" style="animation-delay: 0.2s;">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="section-title mb-0">Notifications</h3>
                                {% if user.notifications is defined and user.notifications is not empty %}
                                    {% set unread = user.notifications|filter(n => not n.read|default(false))|length %}
                                    {% if unread > 0 %}
                                        <span class="badge bg-warning text-dark">{{ unread }} nouvelle(s)</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                            {% if user.notifications is defined and user.notifications is not empty %}
                                <div class="notification-scroll" style="max-height: 300px; overflow-y: auto;">
                                    {% for notif in user.notifications|reverse %}
                                        <div class="notification-item mb-2 p-3 rounded-3" style="background: rgba(255,255,255,{% if not notif.read|default(false) %}0.08{% else %}0.03{% endif %}); border-left: 4px solid {% if notif.status == 'confirmed' %}#28a745{% elseif notif.status == 'cancelled' %}#dc3545{% elseif notif.status == 'completed' %}#6c757d{% else %}#ffc107{% endif %};">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-fill">
                                                    <h6 class="mb-1 fw-bold" style="color: var(--primary); font-size: 0.85rem;">
                                                        {{ notif.title|default('Notification') }}
                                                        {% if not notif.read|default(false) %}
                                                            <span class="badge bg-warning text-dark ms-2" style="font-size: 0.6rem;">Nouveau</span>
                                                        {% endif %}
                                                    </h6>
                                                    <p class="mb-1 small" style="color: #fff; opacity: 0.8;">{{ notif.message|default('') }}</p>
                                                    <small class="text-muted" style="font-size: 0.7rem;">{{ notif.date|default('') }}</small>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">Aucune notification pour le moment.</p>
                            {% endif %}
                        </div>

                        <div class="glass-card fade-in-up" style="animation-delay: 0.3s;">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="section-title mb-0">Historique des Réservations</h3>
                                <a href="{{ path('front_index') }}#book-a-table" class="btn-gold py-1 px-3" style="font-size: 0.75rem;">
                                    <i class="bi bi-plus-lg me-1"></i> Réserver
                                </a>
                            </div>

                            {% if user.reservations is defined and user.reservations is not empty %}
                                <div class="d-flex gap-3 mb-4 flex-wrap">
                                    <div class="flex-fill text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
                                        <h4 class="mb-0 fw-bold" style="color: var(--primary);">{{ user.reservations|length }}</h4>
                                        <small class="text-white opacity-75">Total</small>
                                    </div>
                                    {% set upcoming = user.reservations|filter(r => (r.reservationStatus|default(r.status|default('pending'))) == 'pending' and r.date >= 'now'|date('Y-m-d'))|length %}
                                    <div class="flex-fill text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
                                        <h4 class="mb-0 fw-bold text-warning">{{ upcoming }}</h4>
                                        <small class="text-white opacity-75">À venir</small>
                                    </div>
                                </div>
                                <div class="reservation-scroll">
                                    {% for reservation in user.reservations %}
                                        {% set resStatus = reservation.reservationStatus|default(reservation.status|default('pending')) %}
                                        {% set borderColor = 'var(--primary)' %}
                                        {% if resStatus == 'pending' %}
                                            {% set borderColor = '#ffc107' %}
                                        {% elseif resStatus == 'confirmed' or resStatus == 'reserved' %}
                                            {% set borderColor = '#28a745' %}
                                        {% elseif resStatus == 'cancelled' %}
                                            {% set borderColor = '#dc3545' %}
                                        {% elseif resStatus == 'completed' %}
                                            {% set borderColor = '#6c757d' %}
                                        {% endif %}
                                        <div class="reservation-item mb-3 p-3 rounded-3" data-reservation-id="{{ reservation.id }}" style="background: rgba(255,255,255,0.03); border-left: 4px solid {{ borderColor }}; transition: background 0.2s;">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                                <div class="flex-fill">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <h4 class="h6 mb-0 fw-bold" style="color: var(--primary);">Table pour {{ reservation.people|default(0) }} personnes</h4>
                                                        <span class="badge rounded-pill" data-reservation-status-badge style="background: {{ borderColor }}; color: #fff; font-size: 0.65rem;">{{ resStatus == 'pending' ? 'En attente' : resStatus == 'confirmed' or resStatus == 'reserved' ? 'Confirmée' : resStatus == 'cancelled' ? 'Annulée' : resStatus == 'completed' ? 'Terminée' : resStatus }}</span>
                                                    </div>
                                                    <p class="mb-1 small" style="color: #fff; opacity: 0.9;">
                                                        <i class="bi bi-calendar3 me-1"></i><strong>{{ reservation.date|default('N/A') }}</strong> à {{ reservation.time|default('N/A') }}
                                                    </p>
                                                    {% if reservation.message %}
                                                        <p class="mb-0 small" style="color: #fff; opacity: 0.7;">
                                                            <i class="bi bi-chat me-1"></i>{{ reservation.message }}
                                                        </p>
                                                    {% endif %}
                                                    <p class="mb-0 mt-1 small" style="color: #fff; opacity: 0.5;"><i class="bi bi-hash me-1"></i>Réf: #{{ reservation.id|slice(0,6)|upper }}</p>
                                                </div>
                                                <div class="text-end">
                                                    {% if resStatus == 'pending' %}
                                                        {% set today = 'now'|date('Y-m-d') %}
                                                        {% if reservation.date >= today %}
<form method="post" action="{{ path('client_cancel_reservation', {'tableId': reservation.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette réservation ?');">
                                                                 <input type="hidden" name="_token" value="{{ csrf_token('cancel-reservation' ~ reservation.id) }}">
                                                                 <button type="submit" class="btn btn-sm btn-outline-danger mt-1" style="font-size: 0.7rem; padding: 5px 14px;">
                                                                     <i class="bi bi-x-circle me-1"></i>Annuler
                                                                 </button>
                                                             </form>
                                                        {% else %}
                                                            <span class="badge bg-secondary mt-1" style="font-size: 0.65rem;"><i class="bi bi-lock me-1"></i>Passée</span>
                                                        {% endif %}
                                                    {% elseif resStatus == 'confirmed' or resStatus == 'reserved' %}
                                                        <span class="badge bg-success mt-1" style="font-size: 0.65rem;"><i class="bi bi-check-circle me-1"></i>Confirmée</span>
                                                    {% else %}
                                                        <span class="badge bg-secondary mt-1" style="font-size: 0.65rem;"><i class="bi bi-lock me-1"></i>{{ resStatus == 'cancelled' ? 'Annulée' : 'Terminée' }}</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <div class="avatar-circle mx-auto mb-3" style="width: 70px; height: 70px; background: rgba(255,255,255,0.05); color: var(--primary);">
                                        <i class="bi bi-calendar-x fs-1"></i>
                                    </div>
                                    <p class="text-white opacity-75 mb-1 fw-semibold">Vous n'avez pas encore de réservation</p>
                                    <p class="text-muted small mb-3">Réservez votre première table en quelques clics</p>
                                    <a href="{{ path('front_index') }}#book-a-table" class="btn-gold py-2 px-4" style="font-size: 0.8rem;">
                                        <i class="bi bi-plus-lg me-1"></i> Réserver maintenant
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script>
        (function () {
            const passwordInput = document.getElementById('pwd');
            const togglePassword = document.getElementById('togglePassword');
            const avatar = document.getElementById('profileAvatar');
            const nameInput = document.getElementById('nomComplete');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function () {
                    const isPassword = passwordInput.type === 'password';
                    passwordInput.type = isPassword ? 'text' : 'password';
                    this.innerHTML = isPassword ? '<i class="bi bi-eye-slash text-white"></i>' : '<i class="bi bi-eye text-white"></i>';
                });
            }

            if (nameInput && avatar) {
                nameInput.addEventListener('input', function () {
                    const value = this.value.trim();
                    avatar.textContent = value ? value.charAt(0).toUpperCase() : 'C';
                });
            }

            const telInput = document.getElementById('tel');
            if (telInput) {
                telInput.addEventListener('input', function () {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            const reservationContainer = document.querySelector('.reservation-scroll');
            if (reservationContainer) {
                const statusLabels = {
                    pending: 'En attente',
                    confirmed: 'Confirmée',
                    reserved: 'Confirmée',
                    cancelled: 'Annulée',
                    completed: 'Terminée'
                };
                const statusColors = {
                    pending: '#ffc107',
                    confirmed: '#28a745',
                    reserved: '#28a745',
                    cancelled: '#dc3545',
                    completed: '#6c757d'
                };

                const renderReservations = function (reservations) {
                    if (!reservations || reservations.length === 0) {
                        reservationContainer.innerHTML = '<div class="text-center py-5"><div class="avatar-circle mx-auto mb-3" style="width: 70px; height: 70px; background: rgba(255,255,255,0.05); color: var(--primary);"><i class="bi bi-calendar-x fs-1"></i></div><p class="text-white opacity-75 mb-1 fw-semibold">Vous n\'avez pas encore de réservation</p><p class="text-muted small mb-3">Réservez votre première table en quelques clics</p><a href="{{ path('front_index') }}#book-a-table" class="btn-gold py-2 px-4" style="font-size: 0.8rem;"><i class="bi bi-plus-lg me-1"></i> Réserver maintenant</a></div>';
                        return;
                    }

                    const html = reservations.map(function (reservation) {
                        const status = reservation.reservationStatus || reservation.status || 'pending';
                        const label = statusLabels[status] || status;
                        const color = statusColors[status] || '#ffc107';
                        const today = new Date().toISOString().slice(0, 10);
                        const canCancel = status === 'pending' && reservation.date >= today;
                        const cancelButton = canCancel ? '<form method="post" action="{{ path('client_cancel_reservation', {'tableId': '__ID__'}) }}" class="d-inline" onsubmit="return confirm(\'Êtes-vous sûr de vouloir annuler cette réservation ?\');"><input type="hidden" name="_token" value="{{ csrf_token('cancel-reservation' ~ '__ID__') }}"><button type="submit" class="btn btn-sm btn-outline-danger mt-1" style="font-size: 0.7rem; padding: 5px 14px;"><i class="bi bi-x-circle me-1"></i>Annuler</button></form>'.replace(/__ID__/g, reservation.id) : '';

                        return '<div class="reservation-item mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border-left: 4px solid ' + color + '; transition: background 0.2s;">' +
                            '<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">' +
                            '<div class="flex-fill">' +
                            '<div class="d-flex align-items-center gap-2 mb-1">' +
                            '<h4 class="h6 mb-0 fw-bold" style="color: var(--primary);">Table pour ' + (reservation.people || 0) + ' personnes</h4>' +
                            '<span class="badge rounded-pill" style="background: ' + color + '; color: #fff; font-size: 0.65rem;">' + label + '</span>' +
                            '</div>' +
                            '<p class="mb-1 small" style="color: #fff; opacity: 0.9;"><i class="bi bi-calendar3 me-1"></i><strong>' + (reservation.date || 'N/A') + '</strong> à ' + (reservation.time || 'N/A') + '</p>' +
                            (reservation.message ? '<p class="mb-0 small" style="color: #fff; opacity: 0.7;"><i class="bi bi-chat me-1"></i>' + reservation.message + '</p>' : '') +
                            '<p class="mb-0 mt-1 small" style="color: #fff; opacity: 0.5;"><i class="bi bi-hash me-1"></i>Réf: #' + String(reservation.id).slice(0, 6).toUpperCase() + '</p>' +
                            '</div>' +
                            '<div class="text-end">' + cancelButton + '</div>' +
                            '</div>' +
                            '</div>';
                    }).join('');

                    reservationContainer.innerHTML = html;
                };

                const refreshReservationStatuses = function () {
                    fetch('{{ path('user_profile_reservations_data') }}', { cache: 'no-store' })
                        .then(function (response) {
                            if (!response.ok) {
                                throw new Error('Impossible de charger les statuts');
                            }
                            return response.json();
                        })
                        .then(function (data) {
                            renderReservations(data.reservations || []);
                        })
                        .catch(function () {
                            // Ignore silently to avoid disrupting the profile page.
                        });
                };

                refreshReservationStatuses();
                setInterval(refreshReservationStatuses, 10000);
            }

        })();
    </script>
</body>
</html>
