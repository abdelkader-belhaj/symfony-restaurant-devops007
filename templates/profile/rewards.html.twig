<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadeaux - Délicieux</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        :root {
            --bg: #1e160d; /* Dark restoration bg */
            --surface: #42301c; /* Surface from Delicious theme */
            --surface-strong: #2d2214;
            --text: #ffffff;
            --muted: #adadad;
            --accent: #ffb03b; /* Gold/Orange from Delicious */
            --accent-2: #e69b2d;
            --success: #ffb03b; /* Using accent for success to keep theme consistency */
            --warning: #f59e0b;
            --shadow: 0 24px 70px rgba(0, 0, 0, 0.6);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            color: var(--text);
            background:
                linear-gradient(rgba(30, 22, 13, 0.9), rgba(30, 22, 13, 0.9)),
                url('{{ asset("assets/img/hero-bg.jpg") }}');
            background-size: cover;
            background-attachment: fixed;
            min-height: 100vh;
        }

        .shell {
            position: relative;
            min-height: 100vh;
            padding-top: 100px; /* Offset for fixed header */
            padding-bottom: 60px;
        }

        .hero {
            padding: 40px 0 20px;
            text-align: center;
        }

        .hero h1 {
            margin: 10px 0 10px;
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 800;
            color: var(--accent);
            font-family: 'Satisfy', cursive;
            letter-spacing: 0.02em;
        }

        .hero p {
            margin: 0 auto;
            max-width: 700px;
            font-size: 1.1rem;
            color: var(--muted);
        }

        .grid {
            padding: 0 0 60px;
        }

        .cardx {
            background: var(--surface);
            border-radius: 20px;
            border: 1px solid rgba(255, 176, 59, 0.2);
            box-shadow: var(--shadow);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .cardx:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
        }

        .overview,
        .details,
        .rules {
            padding: 28px;
        }

        .reward-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .reward-active { background: rgba(255, 176, 59, 0.2); color: var(--accent); }
        .reward-waiting { background: rgba(255, 255, 255, 0.1); color: var(--muted); }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent);
            display: block;
            margin-bottom: 10px;
        }

        .btn-soft {
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-soft:hover {
            transform: translateY(-2px);
        }

        .btn-accent-soft {
            background: var(--accent);
            color: #1e160d;
        }

        .metric-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-top: 22px;
        }

        .metric {
            padding: 24px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
        }

        .metric .label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .metric .value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--accent);
        }

        .progress {
            height: 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.1);
            overflow: hidden;
        }

        .progress-bar {
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
        }

        .gift-card {
            padding: 35px;
            border-radius: 25px;
            background: linear-gradient(135deg, #42301c, #2d2214);
            color: #fff;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 176, 59, 0.2);
        }

        .gift-card::after {
            content: '🎁';
            position: absolute;
            right: -20px;
            bottom: -20px;
            font-size: 120px;
            opacity: 0.1;
            transform: rotate(-15deg);
        }

        .gift-number {
            font-size: clamp(2rem, 5vw, 4rem);
            font-weight: 800;
            line-height: 1;
            margin: 0;
        }

        .gift-note {
            color: rgba(255, 255, 255, 0.82);
        }

        .gift-list {
            display: grid;
            gap: 12px;
        }

        .roulette-card {
            background: radial-gradient(circle at center, #42301c 0%, #1e160d 100%);
            color: #fff;
            padding: 40px;
            border-radius: 40px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 176, 59, 0.2);
        }

        .roulette-card::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at center, rgba(255, 211, 107, 0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        .roulette-header {
            position: relative;
            z-index: 1;
            margin-bottom: 25px;
            text-align: center;
        }

        .roulette-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            font-size: 0.8rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .roulette-title {
            font-size: 2.2rem;
            color: var(--accent);
            margin-bottom: 10px;
            font-weight: 800;
            letter-spacing: -0.03em;
            text-align: center;
            text-shadow: 0 0 20px rgba(255, 176, 59, 0.3);
            font-family: 'Satisfy', cursive;
        }

        .roulette-subtitle {
            margin: 0;
            color: rgba(255, 255, 255, 0.76);
            line-height: 1.7;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .roulette-stage {
            position: relative;
            z-index: 1;
            display: grid;
            gap: 20px;
            justify-items: center;
        }

        .roulette-preview-shell {
            position: relative;
            width: min(100%, 600px);
            aspect-ratio: 1;
            display: grid;
            place-items: center;
            margin: 0 auto;
            filter: drop-shadow(0 0 50px rgba(0, 0, 0, 0.5));
        }

        .roulette-preview-shell::before {
            content: "";
            position: absolute;
            inset: -15px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, transparent, rgba(255, 211, 107, 0.2), transparent 30%);
            animation: rotateOrbit 10s linear infinite;
            pointer-events: none;
        }

        @keyframes rotateOrbit {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .roulette-pointer {
            position: absolute;
            top: -6px;
            left: 50%;
            z-index: 5;
            width: 0;
            height: 0;
            transform: translateX(-50%);
            border-left: 13px solid transparent;
            border-right: 13px solid transparent;
            border-top: 25px solid var(--accent);
            filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.5));
        }

        .roulette-wheel {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 12px solid #2d2214;
            overflow: hidden;
            background: #111;
            box-shadow:
                0 0 0 4px var(--accent),
                inset 0 0 60px rgba(0, 0, 0, 0.8);
            transform: rotate(0deg);
            transition: transform 5s cubic-bezier(0.15, 0, 0.15, 1);
            will-change: transform;
        }

        .roulette-wheel::after {
            content: "";
            position: absolute;
            inset: 12px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.18);
            pointer-events: none;
        }

        .roulette-wheel svg {
            display: block;
            width: 100%;
            height: 100%;
        }

        .roulette-slice-image {
            filter: saturate(1.04) contrast(1.04);
        }

        .roulette-slice-shade {
            fill: rgba(0, 0, 0, 0.15);
        }

        .roulette-slice-border {
            fill: none;
            stroke: rgba(255, 176, 59, 0.4);
            stroke-width: 0.8;
        }

        .roulette-slice-title {
            fill: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 3.2px;
            font-weight: 700;
            text-anchor: middle;
            paint-order: stroke;
            stroke: rgba(0, 0, 0, 0.72);
            stroke-width: 1.2px;
            stroke-linejoin: round;
        }

        .roulette-center {
            position: relative;
            z-index: 2;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle at center, #ffd36b, #ffb03b);
            color: #1a1a1a;
            display: grid;
            place-items: center;
            text-align: center;
            font-weight: 800;
            font-size: 0.85rem;
            box-shadow:
                0 0 30px rgba(255, 176, 59, 0.4),
                inset 0 0 15px rgba(255, 255, 255, 0.5);
            border: 6px solid #2d2214;
        }

        .roulette-center span,
        .roulette-center small {
            display: block;
            line-height: 1.1;
        }

        .roulette-center small {
            font-size: 0.64rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .roulette-cursor-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 0 auto 15px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.88);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            width: fit-content;
        }

        .roulette-btn {
            min-width: 240px;
            padding: 16px 32px;
            border-radius: 999px;
            border: 0;
            background: linear-gradient(135deg, #ffd36b, var(--accent));
            color: #1a1a1a;
            font-weight: 800;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            box-shadow: 0 18px 35px rgba(255, 176, 59, 0.3);
            transition: all .3s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            z-index: 10;
        }

        .roulette-btn:not(:disabled):hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 25px 50px rgba(255, 176, 59, 0.4);
        }

        .roulette-btn:not(:disabled):active {
            transform: translateY(0) scale(0.98);
        }

        .roulette-btn::after {
            content: "";
            position: absolute;
            inset: -4px;
            border-radius: 999px;
            background: linear-gradient(135deg, #ffd36b, #ff8d3c);
            z-index: -1;
            opacity: 0.3;
            filter: blur(8px);
            transition: opacity 0.3s;
        }

        .roulette-btn:not(:disabled):hover::after {
            opacity: 0.6;
        }

        .is-spinning .roulette-btn {
            animation: pulseBtn 1s infinite alternate;
        }

        @keyframes pulseBtn {
            from { opacity: 0.8; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .roulette-result-card {
            max-width: 500px;
            margin: 0 auto;
            border-radius: 22px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            gap: 14px;
            align-items: center;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
        }

        .roulette-result-card img {
            width: 78px;
            height: 78px;
            border-radius: 18px;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.18);
        }

        .roulette-result-card .result-name {
            font-size: 1.05rem;
            font-weight: 800;
            margin: 0;
        }

        .roulette-result-card .result-meta {
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.9rem;
        }

        .roulette-empty {
            max-width: 500px;
            margin: 0 auto;
            padding: 22px;
            border-radius: 22px;
            border: 1px dashed rgba(255, 255, 255, 0.18);
            background: rgba(255, 255, 255, 0.06);
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
        }

        .is-spinning .roulette-wheel {
            filter: saturate(1.2) brightness(1.1);
        }

        .roulette-light-dot {
            position: absolute;
            width: 8px;
            height: 8px;
            background: #fff;
            border-radius: 50%;
            z-index: 6;
            box-shadow: 0 0 10px #fff, 0 0 20px #ffd36b;
        }

        .gift-item {
            display: flex;
            gap: 14px;
            align-items: start;
            padding: 16px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(226, 232, 240, 0.9);
        }

        .gift-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: rgba(255, 107, 53, 0.12);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

        .btn-soft {
            border: 0;
            border-radius: 14px;
            padding: 12px 18px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .btn-accent {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #1e160d;
            box-shadow: 0 16px 30px rgba(255, 176, 59, 0.3);
            font-weight: 700;
        }

        .btn-light-soft {
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-light-soft:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--accent);
        }

        .alert {
            border-radius: 16px;
            border: 0;
            box-shadow: var(--shadow);
        }

        .text-muted-soft { color: var(--muted); }

        @media (max-width: 991px) {
            .metric-row { grid-template-columns: 1fr; }
            .roulette-wheel-shell { max-width: 100%; }
            .roulette-label { width: 138px; margin-left: -69px; }
        }
        .winner-modal {
            position: fixed;
            inset: 0;
            z-index: 5000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, 0.76);
            backdrop-filter: blur(10px);
        }

        .winner-modal.is-visible {
            display: flex;
        }

        .winner-card {
            width: min(460px, 100%);
            border-radius: 24px;
            padding: 32px;
            text-align: center;
            color: #fff;
            background: linear-gradient(135deg, #111827, #243447);
            border: 1px solid rgba(255, 211, 107, 0.38);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.42);
            animation: winnerPop 0.6s cubic-bezier(.2, .8, .2, 1);
        }

        .winner-card img {
            width: 132px;
            height: 132px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #ffd36b;
            box-shadow: 0 0 0 12px rgba(255, 211, 107, 0.16);
            margin-bottom: 20px;
            animation: winnerPulse 1.3s ease-in-out infinite;
        }

        .winner-card h3 {
            margin: 0 0 10px;
            font-size: 1.9rem;
            font-weight: 800;
        }

        .winner-card p {
            color: rgba(255, 255, 255, 0.78);
            margin-bottom: 0;
        }

        .winner-countdown {
            display: inline-flex;
            margin-top: 18px;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(255, 211, 107, 0.16);
            color: #ffd36b;
            font-weight: 700;
        }

        @keyframes winnerPop {
            from { opacity: 0; transform: scale(0.86) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes winnerPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Mobile responsive for nav-auth-section */
        @media (max-width: 768px) {
            .nav-auth-section {
                margin-left: 0;
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px solid rgba(44, 62, 80, 0.1);
                width: 100%;
                display: flex !important;
                justify-content: flex-start;
                flex-direction: column;
            }

            .nav-auth-section .dropdown-menu,
            .nav-auth-section .auth-dropdown {
                position: static !important;
                float: none !important;
                width: 100% !important;
                margin: 10px 0 0 0 !important;
                inset: auto !important;
                right: auto !important;
                left: auto !important;
                top: auto !important;
                border: 1px solid rgba(0, 0, 0, 0.1);
                box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
                background: rgba(248, 249, 250, 0.8);
                border-radius: 4px;
                display: none;
            }

            .nav-auth-section .dropdown-menu.show,
            .nav-auth-section .auth-dropdown.show {
                display: block;
            }

            .nav-auth-section .btn-auth {
                width: 100%;
                justify-content: flex-start;
                padding: 10px 12px;
            }

            .nav-auth-section .auth-dropdown-footer {
                display: flex;
                justify-content: space-around;
                padding: 12px;
            }

            .nav-auth-section .auth-action-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-decoration: none;
                color: inherit;
                font-size: 0.8rem;
                padding: 8px;
            }

            .nav-auth-section .auth-action-item:hover {
                color: var(--accent, #ffb03b);
            }
        }
    </style>
</head>
<body>
     <header id="header" class="header fixed-top">

        <div class="branding d-flex align-items-center">
            <div class="container position-relative d-flex align-items-center justify-content-between">

                <!-- Logo à gauche -->
                <a class="logo d-flex align-items-center" href="{{ path('front_index') }}">
                    <h1 class="sitename">Délicieux</h1>
                </a>

                <!-- Navigation avec auth intégrée -->
                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="{{ path('front_index') }}#hero">Home</a></li>
                        <li><a href="{{ path('front_index') }}#about">About</a></li>
                        <li><a href="{{ path('front_index') }}#menu">Menu</a></li>
                        <li><a href="{{ path('front_index') }}#specials">Specials</a></li>
                        <li><a href="{{ path('front_index') }}#events">Events</a></li>
                        <li><a href="{{ path('front_index') }}#chefs">Chefs</a></li>
                        <li><a href="{{ path('front_index') }}#gallery">Gallery</a></li>
                        <li><a href="{{ path('front_index') }}#contact">Contact</a></li>

   {% if app.session.get('user') %}
    {% set unclaimed_rewards = has_unclaimed_rewards(app.session.get('user')) %}
    <!-- Utilisateur connecté -->
    <li class="nav-auth-section">
        <div class="dropdown">
            <button class="btn btn-auth dropdown-toggle d-flex align-items-center position-relative" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-2"></i>
                <span>nom : {{ app.session.get('user').nomComplete }}</span>
                {% if unclaimed_rewards %}
                    <span class="position-absolute top-0 start-100 translate-middle reward-notification-badge" style="margin-left: -5px; margin-top: 5px;">
                        <span class="reward-pulse"></span>
                    </span>
                {% endif %}
            </button>
            <ul class="dropdown-menu dropdown-menu-end auth-dropdown shadow border-0" aria-labelledby="userDropdown">
                <li class="dropdown-header pb-3 pt-2">
                    <div class="d-flex align-items-center">
                        <div class="user-avatar-initials me-3">
                            {{ app.session.get('user').nomComplete|slice(0, 1)|upper }}
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 1rem;">{{ app.session.get('user').nomComplete }}</h6>
                            <small class="text-muted" style="font-size: 0.8rem;">{{ app.session.get('user').email }}</small>
                        </div>
                    </div>
                </li>
                <li><hr class="dropdown-divider my-0 opacity-10"></li>

                {% if app.session.get('user').type == 'client' %}
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center" href="{{ path('user_profile') }}">
                            <div class="icon-box me-3 bg-light-blue">
                                <i class="bi bi-person text-primary"></i>
                            </div>
                            <span>Mon Profil</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center position-relative" href="{{ path('user_rewards') }}">
                            <div class="icon-box me-3 bg-light-gold">
                                <i class="bi bi-gift text-warning"></i>
                            </div>
                            <span>Mes Cadeaux</span>
                            {% if unclaimed_rewards %}
                                <span class="badge rounded-pill bg-danger ms-auto gift-badge-anim">Nouveau</span>
                            {% endif %}
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1 opacity-10"></li>
                {% endif %}

                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center text-danger" href="{{ path('app_logout') }}">
                        <div class="icon-box me-3 bg-light-danger">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>
                        <span>Déconnexion</span>
                    </a>
                </li>
