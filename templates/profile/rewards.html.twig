  <!-- Main JS File -->
  <script src="{{ asset('assets/js/main.js') }}"></script>

    <script>
        (function () {
            const rouletteItems = {{ rouletteItems|json_encode|raw }};
            const rouletteAvailable = {{ reward.rouletteAvailable ? 'true' : 'false' }};
            const rouletteUsed = {{ reward.rouletteUsed ? 'true' : 'false' }};
            const spinUrl = '{{ path('user_rewards_spin') }}';
            const rouletteWheel = document.getElementById('rouletteWheel');
            const spinButton = document.getElementById('rouletteSpinBtn');
            const rouletteStage = document.getElementById('rouletteStage');
            const resultCard = document.getElementById('rouletteResultCard');
            const winnerModal = document.getElementById('winnerModal');
            const winnerImage = document.getElementById('winnerImage');
            const winnerText = document.getElementById('winnerText');

            if (rouletteWheel && rouletteItems.length) {
                const wheelItems = rouletteItems;
                const slice = 360 / wheelItems.length;
                rouletteWheel.innerHTML = '';

                const svgNs = 'http://www.w3.org/2000/svg';
                const xlinkNs = 'http://www.w3.org/1999/xlink';
                const svg = document.createElementNS(svgNs, 'svg');
                svg.setAttribute('viewBox', '0 0 100 100');
                svg.setAttribute('aria-hidden', 'true');

                const defs = document.createElementNS(svgNs, 'defs');
                svg.appendChild(defs);

                const polarPoint = (angleDeg, radius = 50) => {
                    const angleRad = (angleDeg - 90) * Math.PI / 180;
                    return {
                        x: 50 + radius * Math.cos(angleRad),
                        y: 50 + radius * Math.sin(angleRad)
                    };
                };

                const slicePath = (startAngle, endAngle) => {
                    const start = polarPoint(startAngle);
                    const end = polarPoint(endAngle);
                    const largeArc = endAngle - startAngle > 180 ? 1 : 0;
                    return `M 50 50 L ${start.x.toFixed(3)} ${start.y.toFixed(3)} A 50 50 0 ${largeArc} 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)} Z`;
                };

                wheelItems.forEach((item, index) => {
                    const startAngle = index * slice;
                    const endAngle = startAngle + slice;
                    const middleAngle = startAngle + (slice / 2);
                    const pathData = slicePath(startAngle, endAngle);
                    const clipId = `roulette-slice-${index}`;

                    const clipPath = document.createElementNS(svgNs, 'clipPath');
                    clipPath.setAttribute('id', clipId);

                    const clipShape = document.createElementNS(svgNs, 'path');
                    clipShape.setAttribute('d', pathData);
                    clipPath.appendChild(clipShape);
                    defs.appendChild(clipPath);

                    const image = document.createElementNS(svgNs, 'image');
                    image.setAttribute('x', '0');
                    image.setAttribute('y', '0');
                    image.setAttribute('width', '100');
                    image.setAttribute('height', '100');
                    image.setAttribute('preserveAspectRatio', 'xMidYMid slice');
                    image.setAttribute('clip-path', `url(#${clipId})`);
                    image.setAttribute('class', 'roulette-slice-image');
                    image.setAttributeNS(xlinkNs, 'href', item.image || '{{ asset('assets/img/favicon.png') }}');
                    image.setAttribute('href', item.image || '{{ asset('assets/img/favicon.png') }}');
                    svg.appendChild(image);

                    const shade = document.createElementNS(svgNs, 'path');
                    shade.setAttribute('d', pathData);
                    shade.setAttribute('class', 'roulette-slice-shade');
                    svg.appendChild(shade);

                    const border = document.createElementNS(svgNs, 'path');
                    border.setAttribute('d', pathData);
                    border.setAttribute('class', 'roulette-slice-border');
                    svg.appendChild(border);

                    /*
                    const titlePoint = polarPoint(middleAngle, 34);
                    const title = document.createElementNS(svgNs, 'text');
                    title.setAttribute('x', titlePoint.x.toFixed(2));
                    title.setAttribute('y', titlePoint.y.toFixed(2));
                    title.setAttribute('class', 'roulette-slice-title');
                    title.textContent = item.titre || item.name || 'Plat';
                    svg.appendChild(title);
                    */
                });

                rouletteWheel.appendChild(svg);

                // Ajout de petits points lumineux décoratifs autour de la roue
                for (let i = 0; i < 12; i++) {
                    const dot = document.createElement('div');
                    dot.className = 'roulette-light-dot';
                    const angle = i * (360 / 12);
                    const point = polarPoint(angle, 53); // Un peu plus loin que le rayon de 50
                    dot.style.left = `${point.x}%`;
                    dot.style.top = `${point.y}%`;
                    dot.style.transform = 'translate(-50%, -50%)';
                    document.querySelector('.roulette-preview-shell').appendChild(dot);
                }
            }

            async function spinRoulette() {
                if (!spinButton || rouletteUsed || !rouletteAvailable) {
                    return;
                }

                spinButton.disabled = true;
                spinButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Tirage en cours...';

                try {
                    const response = await fetch(spinUrl, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({})
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || 'Impossible de lancer la roulette.');
                    }

                    const result = payload.result;
                    const pool = rouletteItems;
                    const index = Math.max(pool.findIndex((item) => {
                        const itemId = String(item.id ?? item.key ?? '');
                        const resultId = String(result.id ?? result.key ?? '');
                        return itemId !== '' && itemId === resultId;
                    }), 0);
                    const spinSlice = 360 / pool.length;

                    // Calcul de la rotation pour que le segment gagnant s'arrête en haut (curseur)
                    // La rotation initiale est 0. Le curseur est en haut (270 deg en coordonnées trigonométriques standard, ou 0 deg dans notre SVG polarPoint).
                    // Pour que l'index 'index' soit en haut, on doit faire pivoter la roue de -(index * slice + slice/2)
                    const targetRotation = 1440 - (index * spinSlice + spinSlice / 2);

                    if (rouletteStage) {
                        rouletteStage.classList.add('is-spinning');
                    }

                    rouletteWheel.style.transform = `rotate(${targetRotation}deg)`;

                    // Effet de confettis discret au début du spin
                    try { if (typeof confetti === 'function') { confetti({
                        particleCount: 50,
                        spread: 60,
                        origin: { y: 0.8 },
                        colors: ['#ffd36b', '#ff8d3c', '#ffffff']
                    }); } } catch(e) {}

                    setTimeout(() => {
                        // Explosion de confettis au moment du gain
                        const duration = 3 * 1000;
                        const end = Date.now() + duration;

                        (function frame() {
                            try { if (typeof confetti === 'function') { confetti({
                                particleCount: 3,
                                angle: 60,
                                spread: 55,
                                origin: { x: 0 },
                                colors: ['#ffd36b', '#ff8d3c']
                            }); } } catch(e) {}
                            try { if (typeof confetti === 'function') { confetti({
                                particleCount: 3,
                                angle: 120,
                                spread: 55,
                                origin: { x: 1 },
                                colors: ['#ffd36b', '#ff8d3c']
                            }); } } catch(e) {}

                            if (Date.now() < end) {
                                requestAnimationFrame(frame);
                            }
                        }());

                        if (resultCard) {
                            const image = result.image || '{{ asset('assets/img/favicon.png') }}';
                            const title = result.titre || result.name || 'Plat surprise';
                            resultCard.className = 'roulette-result-card mt-4';
                            resultCard.style.display = 'flex';
                            resultCard.innerHTML = `
                                <img src="${image}" alt="Plat gagné">
                                <div>
                                    <p class="result-name mb-1">${title}</p>
                                    <div class="result-meta">Plat gagné avec la roulette premium. Le cadeau est consommé une seule fois.</div>
                                </div>
                            `;
                        }

                        spinButton.innerHTML = '<i class="bi bi-check2-circle me-2"></i> Roulette consommée';
                        spinButton.disabled = true;
                        if (winnerModal) {
                            const winnerTitle = result.titre || result.name || 'Plat surprise';
                            if (winnerImage) {
                                winnerImage.src = result.image || '{{ asset('assets/img/favicon.png') }}';
                            }
                            if (winnerText) {
                                winnerText.textContent = `${winnerTitle} est ajoute a une commande totalement gratuite.`;
                            }
                            winnerModal.classList.add('is-visible');
                        }

                        setTimeout(() => {
                            window.location.href = payload.redirectUrl || '{{ path('app_menu_commande') }}?rouletteGift=1';
                        }, 2200);
                    }, 5000);
                } catch (error) {
                    spinButton.disabled = false;
                    spinButton.innerHTML = '<i class="bi bi-lightning-charge-fill me-2"></i>Lancer la roulette';
                    alert(error.message || 'Une erreur est survenue.');
                }
            }

            if (spinButton && rouletteAvailable && !rouletteUsed) {
                spinButton.addEventListener('click', spinRoulette);
            }
        })();
    </script>

    <!-- Mobile dropdown handler for nav-auth-section -->
    <script>
        document.querySelectorAll('.nav-auth-section .dropdown-toggle').forEach(toggle => {
            toggle.addEventListener('click', function(e) {
                if (window.innerWidth <= 768) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const menu = this.nextElementSibling;
                    if (menu && (menu.classList.contains('dropdown-menu') || menu.classList.contains('auth-dropdown'))) {
                        document.querySelectorAll('.nav-auth-section .dropdown-menu.show, .nav-auth-section .auth-dropdown.show').forEach(m => {
                            if (m !== menu) {
                                m.classList.remove('show');
                                m.previousElementSibling?.classList.remove('show');
                            }
                        });
                        
                        menu.classList.toggle('show');
                        this.classList.toggle('show');
                        return false;
                    }
                }
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                if (!e.target.closest('.nav-auth-section')) {
                    document.querySelectorAll('.nav-auth-section .dropdown-menu.show, .nav-auth-section .auth-dropdown.show').forEach(menu => {
                        menu.classList.remove('show');
                        menu.previousElementSibling?.classList.remove('show');
                    });
                }
            }
        });
    </script>
</body>
</html>
