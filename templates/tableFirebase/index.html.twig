{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Gestion des Réservations</h2>
            <p class="text-muted mb-0">Gérez toutes vos réservations de table</p>
        </div>
        <a href="{{ path('firebase_table_new') }}" class="btn btn-primary d-flex align-items-center">
            <i class="fas fa-plus-circle me-2"></i>
            Nouvelle réservation
        </a>
    </div>

    {% set total = tables|length %}
    {% set pendingCount = tables|filter(t => (t.reservationStatus|default('pending')) == 'pending')|length %}
    {% set confirmedCount = tables|filter(t => (t.reservationStatus|default('pending')) in ['confirmed', 'reserved'])|length %}
    {% set cancelledCount = tables|filter(t => (t.reservationStatus|default('pending')) == 'cancelled')|length %}
    {% set completedCount = tables|filter(t => (t.reservationStatus|default('pending')) == 'completed')|length %}

    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-start border-4 border-primary shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-0 small text-muted">Total</p>
                            <h4 class="mb-0 fw-bold">{{ total }}</h4>
                        </div>
                        <div class="avatar-circle bg-primary text-white"><i class="fas fa-calendar-alt"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-start border-4 border-warning shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-0 small text-muted">En attente</p>
                            <h4 class="mb-0 fw-bold">{{ pendingCount }}</h4>
                        </div>
                        <div class="avatar-circle bg-warning text-dark"><i class="fas fa-clock"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-start border-4 border-success shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-0 small text-muted">Confirmées</p>
                            <h4 class="mb-0 fw-bold">{{ confirmedCount }}</h4>
                        </div>
                        <div class="avatar-circle bg-success text-white"><i class="fas fa-check-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-start border-4 border-danger shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-0 small text-muted">Annulées</p>
                            <h4 class="mb-0 fw-bold">{{ cancelledCount }}</h4>
                        </div>
                        <div class="avatar-circle bg-danger text-white"><i class="fas fa-times-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-start border-4 border-secondary shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-0 small text-muted">Terminées</p>
                            <h4 class="mb-0 fw-bold">{{ completedCount }}</h4>
                        </div>
                        <div class="avatar-circle bg-secondary text-white"><i class="fas fa-flag-checkered"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par nom ou email..." value="{{ search }}">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="pending" {{ statusFilter == 'pending' ? 'selected' : '' }}>En attente</option>
                        <option value="confirmed" {{ statusFilter == 'confirmed' ? 'selected' : '' }}>Confirmée</option>
                        <option value="reserved" {{ statusFilter == 'reserved' ? 'selected' : '' }}>Réservée</option>
                        <option value="cancelled" {{ statusFilter == 'cancelled' ? 'selected' : '' }}>Annulée</option>
                        <option value="completed" {{ statusFilter == 'completed' ? 'selected' : '' }}>Terminée</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small" id="resultCount">{{ total }} réservation(s) trouvée(s)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0" id="reservationsTable">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0 px-3 py-3 fw-semibold text-uppercase small">Client</th>
                        <th class="border-top-0 py-3 fw-semibold text-uppercase small">Réservation</th>
                        <th class="border-top-0 py-3 fw-semibold text-uppercase small">Personnes</th>
                        <th class="border-top-0 py-3 fw-semibold text-uppercase small">Statut</th>
                        <th class="border-top-0 py-3 text-end pe-3 fw-semibold text-uppercase small">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                {% for key, table in tables %}
                    {% set rStatus = table.reservationStatus|default('pending') %}
                    {% set isPast = (table.date|default('')) < 'now'|date('Y-m-d') %}
                    <tr class="{% if isPast %}table-secondary{% endif %}" style="cursor:pointer" data-key="{{ key }}" data-id="{{ table.id|default(key) }}" data-url="{{ path('firebase_table_reservation_status', {'key': table.id|default(key)}) }}" data-csrf="{{ csrf_token('reservation-status' ~ (table.id|default(key))) }}" data-name="{{ table.name|default('') }}" data-email="{{ table.email|default('') }}" data-tel="{{ table.tel|default('') }}" data-date="{{ table.date|default('') }}" data-time="{{ table.time|default('') }}" data-people="{{ table.numberPeople|default('0') }}" data-status="{{ rStatus }}" data-message="{{ table.message|default('') }}">
                        <td class="px-3 py-3">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-primary text-white me-2">{{ table.name|slice(0,1)|upper }}</div>
                                <div>
                                    <h6 class="mb-0 fw-semibold small">{{ table.name|default('N/A') }}</h6>
                                    <small class="text-muted" style="font-size:0.7rem">{{ table.email|default('N/A') }}</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3">
                            <div class="small">
                                <div><i class="far fa-calendar me-1 text-muted"></i>{{ table.date|default('N/A') }}</div>
                                <div><i class="far fa-clock me-1 text-muted"></i>{{ table.time|default('N/A') }}</div>
                            </div>
                        </td>
                        <td class="py-3">
                            <span class="badge text-bg-dark"><i class="fas fa-users me-1"></i>{{ table.numberPeople|default('0') }}</span>
                        </td>
                        <td class="py-3">
                            {% if rStatus == 'pending' %}
                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>
                            {% elseif rStatus == 'confirmed' or rStatus == 'reserved' %}
                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>
                            {% elseif rStatus == 'cancelled' %}
                                <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Annulée</span>
                            {% elseif rStatus == 'completed' %}
                                <span class="badge bg-secondary"><i class="fas fa-flag me-1"></i>Terminée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">{{ rStatus }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-3 py-3">
                            <div class="dropdown d-inline">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-tag me-1"></i> Statut
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item small change-reservation-status" data-key="{{ key }}" data-id="{{ table.id|default(key) }}" data-status="pending" data-url="{{ path('firebase_table_reservation_status', {'key': table.id|default(key)}) }}" data-csrf="{{ csrf_token('reservation-status' ~ (table.id|default(key))) }}">
                                            <i class="fas fa-clock text-warning me-2"></i>En attente
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item small change-reservation-status" data-key="{{ key }}" data-id="{{ table.id|default(key) }}" data-status="confirmed" data-url="{{ path('firebase_table_reservation_status', {'key': table.id|default(key)}) }}" data-csrf="{{ csrf_token('reservation-status' ~ (table.id|default(key))) }}">
                                            <i class="fas fa-check text-success me-2"></i>Confirmée
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item small change-reservation-status" data-key="{{ key }}" data-id="{{ table.id|default(key) }}" data-status="cancelled" data-url="{{ path('firebase_table_reservation_status', {'key': table.id|default(key)}) }}" data-csrf="{{ csrf_token('reservation-status' ~ (table.id|default(key))) }}">
                                            <i class="fas fa-times text-danger me-2"></i>Annulée
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item small change-reservation-status" data-key="{{ key }}" data-id="{{ table.id|default(key) }}" data-status="completed" data-url="{{ path('firebase_table_reservation_status', {'key': table.id|default(key)}) }}" data-csrf="{{ csrf_token('reservation-status' ~ (table.id|default(key))) }}">
                                            <i class="fas fa-flag me-2"></i>Terminée
                                        </button>
                                    </li>
                                </ul>
                            </div>
                            <div class="d-inline gap-2 ms-1">
                                <a href="{{ path('firebase_table_edit', {'key': key}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('firebase_table_delete', {'key': key}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ key) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fas fa-calendar-times fa-3x mb-3 d-block"></i>
                            <p class="mb-0 fw-semibold">Aucune réservation trouvée</p>
                            <p class="mb-0 small text-muted">Essayez un autre critère de recherche ou créez une nouvelle réservation.</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Détails Réservation -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-receipt me-2"></i>Détails de la réservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar-circle bg-primary text-white me-3" id="modalAvatar" style="width:48px;height:48px;font-size:1.4rem">J</div>
                    <div>
                        <h5 class="mb-0" id="modalName">—</h5>
                        <small class="text-muted">#<span id="modalKey">—</span></small>
                    </div>
                </div>
                <hr>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="fas fa-envelope me-1"></i>Email</p>
                        <p class="mb-0 fw-medium" id="modalEmail">—</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="fas fa-phone me-1"></i>Téléphone</p>
                        <p class="mb-0 fw-medium" id="modalTel">—</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="far fa-calendar me-1"></i>Date</p>
                        <p class="mb-0 fw-medium" id="modalDate">—</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="far fa-clock me-1"></i>Heure</p>
                        <p class="mb-0 fw-medium" id="modalTime">—</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="fas fa-users me-1"></i>Personnes</p>
                        <p class="mb-0 fw-medium" id="modalPeople">—</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1 small text-muted"><i class="fas fa-tag me-1"></i>Statut</p>
                        <p class="mb-0 fw-medium" id="modalStatus">—</p>
                    </div>
                    <div class="col-12">
                        <p class="mb-1 small text-muted"><i class="fas fa-comment me-1"></i>Message</p>
                        <p class="mb-0 fw-medium" id="modalMessage">—</p>
                    </div>
                </div>
                <hr>
                <p class="mb-2 small text-muted fw-semibold"><i class="fas fa-tag me-1"></i>Changer le statut</p>
                <div class="d-flex gap-2 flex-wrap" id="modalActions">
                    <button class="btn btn-sm btn-outline-warning modal-status-btn" data-status="pending">
                        <i class="fas fa-clock me-1"></i>En attente
                    </button>
                    <button class="btn btn-sm btn-outline-success modal-status-btn" data-status="confirmed">
                        <i class="fas fa-check me-1"></i>Confirmée
                    </button>
                    <button class="btn btn-sm btn-outline-danger modal-status-btn" data-status="cancelled">
                        <i class="fas fa-times me-1"></i>Annulée
                    </button>
                    <button class="btn btn-sm btn-outline-secondary modal-status-btn" data-status="completed">
                        <i class="fas fa-flag me-1"></i>Terminée
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="actionToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var searchInput = document.getElementById('searchInput');
    var statusFilter = document.getElementById('statusFilter');
    var resultCount = document.getElementById('resultCount');
    var tableBody = document.getElementById('tableBody');
    var rows = tableBody ? tableBody.querySelectorAll('tr') : [];

    function updateCount() {
        var visible = 0;
        rows.forEach(function (row) {
            if (row.style.display !== 'none') { visible++; }
        });
        if (resultCount) { resultCount.textContent = visible + ' réservation(s) trouvée(s)'; }
    }

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            var query = this.value.toLowerCase();
            rows.forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
            });
            updateCount();
        });
    }

    if (statusFilter) {
        statusFilter.addEventListener('change', function () {
            var status = this.value;
            var statusMap = {
                'pending': 'en attente',
                'confirmed': 'confirmée',
                'reserved': 'confirmée',
                'cancelled': 'annulée',
                'completed': 'terminée'
            };
            rows.forEach(function (row) {
                if (!status) { row.style.display = ''; return; }
                var statusText = statusMap[status] || status;
                var badge = row.querySelector('.badge');
                var text = badge ? badge.textContent.trim().toLowerCase() : '';
                row.style.display = text === statusText ? '' : 'none';
            });
            updateCount();
        });
    }

    updateCount();

    // --- Click on row → show detail modal ---
    var currentModalRow = null;
    rows.forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('.dropdown, .btn, form, a, button')) return;
            currentModalRow = row;
            document.getElementById('modalAvatar').textContent = (row.dataset.name || '?')[0].toUpperCase();
            document.getElementById('modalName').textContent = row.dataset.name || '—';
            document.getElementById('modalKey').textContent = row.dataset.key || '—';
            document.getElementById('modalEmail').textContent = row.dataset.email || '—';
            document.getElementById('modalTel').textContent = row.dataset.tel || '—';
            document.getElementById('modalDate').textContent = row.dataset.date || '—';
            document.getElementById('modalTime').textContent = row.dataset.time || '—';
            document.getElementById('modalPeople').textContent = row.dataset.people || '—';
            document.getElementById('modalMessage').textContent = row.dataset.message || 'Aucun message';
            updateModalStatus(row.dataset.status);
            var modal = new bootstrap.Modal(document.getElementById('detailModal'));
            modal.show();
        });
    });

    function updateModalStatus(status) {
        var labels = {
            'pending': '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>',
            'confirmed': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>',
            'reserved': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Réservée</span>',
            'cancelled': '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Annulée</span>',
            'completed': '<span class="badge bg-secondary"><i class="fas fa-flag me-1"></i>Terminée</span>'
        };
        document.getElementById('modalStatus').innerHTML = labels[status] || status;
        document.querySelectorAll('#modalActions .modal-status-btn').forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.status === status);
        });
    }

    // --- Modal status buttons ---
    document.querySelectorAll('.modal-status-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!currentModalRow) return;
            if (!confirm('Voulez-vous vraiment changer le statut ?')) return;

            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>';

            fetch(currentModalRow.dataset.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '_token=' + encodeURIComponent(currentModalRow.dataset.csrf) + '&reservationStatus=' + encodeURIComponent(btn.dataset.status) + '&reservationId=' + encodeURIComponent(currentModalRow.dataset.id || currentModalRow.dataset.key)
            })
            .then(function(response) {
                return response.json().then(function(data) {
                    if (response.ok && data.success) {
                        currentModalRow.dataset.status = btn.dataset.status;
                        var badgeCell = currentModalRow.querySelector('td:nth-child(4)');
                        var rowLabels = {
                            'pending': '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>',
                            'confirmed': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>',
                            'reserved': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Réservée</span>',
                            'cancelled': '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Annulée</span>',
                            'completed': '<span class="badge bg-secondary"><i class="fas fa-flag me-1"></i>Terminée</span>'
                        };
                        badgeCell.innerHTML = rowLabels[btn.dataset.status] || btn.dataset.status;
                        updateModalStatus(btn.dataset.status);
                        showToast(data.message || 'Statut mis à jour avec succès', 'success');
                    } else {
                        throw new Error(data.message || 'Erreur serveur');
                    }
                });
            })
            .catch(function(error) {
                showToast('Erreur : ' + error.message, 'error');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            });
        });
    });

    // --- Toast helper ---
    function showToast(message, type) {
        var toastEl = document.getElementById('actionToast');
        var toastBody = document.getElementById('toastMessage');
        toastEl.className = 'toast align-items-center border-0 text-white bg-' + (type === 'error' ? 'danger' : 'success');
        toastBody.textContent = message;
        var toast = bootstrap.Toast.getOrCreateInstance(toastEl);
        toast.show();
    }

    // --- Reservation status change via AJAX ---
    document.querySelectorAll('.change-reservation-status').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            if (!confirm('Voulez-vous vraiment changer le statut ?')) return;

            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>En cours...';

            fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '_token=' + encodeURIComponent(btn.dataset.csrf) + '&reservationStatus=' + encodeURIComponent(btn.dataset.status) + '&reservationId=' + encodeURIComponent(btn.dataset.id || btn.dataset.key)
            })
            .then(function(response) {
                return response.json().then(function(data) {
                    if (response.ok && data.success) {
                        var row = document.querySelector('tr[data-key="' + btn.dataset.key + '"]');
                        if (row) {
                            row.dataset.status = btn.dataset.status;
                            var badgeCell = row.querySelector('td:nth-child(4)');
                            var statusLabels = {
                                'pending': '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>',
                                'confirmed': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>',
                                'reserved': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Réservée</span>',
                                'cancelled': '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Annulée</span>',
                                'completed': '<span class="badge bg-secondary"><i class="fas fa-flag me-1"></i>Terminée</span>'
                            };
                            badgeCell.innerHTML = statusLabels[btn.dataset.status] || btn.dataset.status;
                        }
                        showToast(data.message || 'Statut mis à jour avec succès', 'success');
                    } else {
                        throw new Error(data.message || 'Erreur serveur');
                    }
                });
            })
            .catch(function(error) {
                showToast('Erreur : ' + error.message, 'error');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            });
        });
    });
});
</script>

<style>
